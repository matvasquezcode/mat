# Copy this file to .env and fill in real values.

PORT=8787

# Required for real lesson generation. Without it, /api/generate-lesson
# returns 502 and the frontend falls back to mock lessons.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: enable real Stripe checkout for the Premium paywall.
# Without these, /api/create-checkout-session returns 501 and the
# frontend falls back to its local "demo unlock" toggle.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe redirect URLs. Set to wherever the frontend is served.
APP_URL=http://localhost:5173
